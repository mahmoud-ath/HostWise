# HostWise backend (Rust) — copy this file to .env and adjust as needed.

# Server
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Database
DATABASE_TYPE=sqlite
# SQLITE_PATH=  # default: platform app-data dir / hostwise.db

# JWT auth
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-64
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS — allow the Tauri webview origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","tauri://localhost","https://tauri.localhost"]

# AI (optional)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
