{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HostWise",
  "version": "0.6.4",
  "identifier": "com.hostwise.desktop",
  "build": {
    "beforeDevCommand": "bun run dev -- --port 3000",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HostWise",
        "width": 1280,
        "height": 820,
        "minWidth": 940,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Finance",
    "shortDescription": "Vacation rental financial intelligence",
    "longDescription": "HostWise — an AI-powered financial intelligence platform for vacation rental hosts. Local-first: your data stays on your machine.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/hostwise-backend": "hostwise-backend"
    },
    "createUpdaterArtifacts": false
  }
}
