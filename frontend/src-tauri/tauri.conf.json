{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HostWise",
  "version": "0.8.1",
  "identifier": "com.hostwise.desktop",
  "build": {
    "beforeDevCommand": "bun run dev -- --port 3000",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HostWise",
        "width": 1280,
        "height": 820,
        "minWidth": 940,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQxQTQ5NzQ1MUU5NkQxNTIKUldSUzBaWWVSWmVrMGFUTk00QWYwaUlQVjRTUW9hUldTM2YvcUg0Uk5UZGZib0tZZ0JBT091ZlAK",
      "endpoints": [
        "https://github.com/mahmoud-ath/HostWise/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Finance",
    "shortDescription": "Vacation rental financial intelligence",
    "longDescription": "HostWise — an AI-powered financial intelligence platform for vacation rental hosts. Local-first: your data stays on your machine.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  }
}
