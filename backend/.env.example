# HostWise — Environment Variables
# Copy this to .env and customize for your environment

# Application
APP_NAME=HostWise
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://hostwise:hostwise@db:5432/hostwise
DATABASE_URL_SYNC=postgresql+psycopg2://hostwise:hostwise@db:5432/hostwise

# JWT Authentication (CHANGE IN PRODUCTION)
JWT_SECRET_KEY=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Upload
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=50

# AI (optional — for future LLM integration)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Email (optional — for future notifications)
SMTP_HOST=
SMTP_PORT=587
