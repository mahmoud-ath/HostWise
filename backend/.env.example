# ═══════════════════════════════════════════════════════════
# HostWise — Environment Configuration
# ═══════════════════════════════════════════════════════════
# Copy this to .env and customize.
# NEVER commit the actual .env file to version control.
# ═══════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────
APP_NAME=HostWise
APP_VERSION=0.1.0
ENVIRONMENT=development       # "development" or "production"
DEBUG=false                   # Enable detailed error responses
LOG_LEVEL=info                # debug | info | warning | error

# ── Server ───────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Database ─────────────────────────────────────────────
# For SQLite (default):
DATABASE_TYPE=sqlite
SQLITE_PATH=hostwise.db
# For PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://hostwise:hostwise@localhost:5432/hostwise
# DATABASE_URL_SYNC=postgresql+psycopg2://hostwise:hostwise@localhost:5432/hostwise

# ── JWT Authentication ───────────────────────────────────
# GENERATE A STRONG SECRET:
#   python3 -c "import secrets; print(secrets.token_hex(64))"
#   openssl rand -hex 64
JWT_SECRET_KEY=change-me-to-a-random-64-char-hex-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── CORS ─────────────────────────────────────────────────
# In production, restrict to your actual domain:
# CORS_ORIGINS=["https://yourdomain.com"]
CORS_ORIGINS=["http://localhost:3000"]

# ── Uploads ──────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# ── AI (optional) ────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ── Email (optional) ─────────────────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
